{
  "name": "yamb-markdown",
  "version": "0.1.4",
  "description": "Editable Markdown tokens and sanitized HTML and text projections for Yamb",
  "keywords": [
    "html",
    "markdown",
    "yamb"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamb/markdown.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core": "yamb",
    "#core/*": "yamb/*"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "dependencies": {
    "@mdit/plugin-inline-rule": "^2.2.5",
    "hast-util-from-html": "^2.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.7",
    "hast-util-to-text": "^4.0.5",
    "markdown-it": "^15.0.3",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "property-information": "^7.2.0"
  },
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "yamb": "1.0.3"
  },
  "peerDependencies": {
    "yamb": "^1.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
